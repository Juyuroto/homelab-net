{
  "description": "Injecte un court résumé de la topologie privée du homelab au démarrage de session",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
